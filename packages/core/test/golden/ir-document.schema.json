        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          }
        }
      },
      "required": [
        "id",
        "text",
        "tag",
        "provenance"
      ],
      "additionalProperties": false
    },
    "NameHole": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "NameHole"
        },
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "reason": {
