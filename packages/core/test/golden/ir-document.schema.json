        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "inferred": {
          "$ref": "#/$defs/InferenceRuleId"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "notes": {
          "$ref": "#/$defs/Notes"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "provenance"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "Provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Span"
      }
    },
    "Span": {
      "type": "object",
      "properties": {
        "utteranceId": {
          "$ref": "#/$defs/Text"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "utteranceId",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "Text": {
      "type": "string",
      "minLength": 1
    },
    "InferenceRuleId": {
      "type": "string",
      "enum": [
        "INF-LOOPVAR",
        "INF-INDEXVAR",
        "INF-RANGE-BOUNDS",
        "INF-SYNONYM",
        "INF-PLURAL-NAME",
        "INF-BLOCK-END"
      ]
    },
    "Notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Note"
      }
    },
    "Note": {
      "type": "object",
      "properties": {
