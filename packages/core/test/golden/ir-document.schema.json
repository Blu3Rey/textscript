{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/IrDocument",
  "$defs": {
    "IrDocument": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "nextId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "program": {
          "$ref": "#/$defs/Program"
        }
      },
      "required": [
        "schemaVersion",
        "nextId",
        "program"
      ],
      "additionalProperties": false
    },
    "Program": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "Program"
        },
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stmt"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "inferred": {
          "$ref": "#/$defs/InferenceRuleId"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "notes": {
          "$ref": "#/$defs/Notes"
        }
      },
      "required": [
        "kind",
        "id",
        "body",
        "provenance"
      ],
      "additionalProperties": false
    },
    "NodeId": {
      "type": "string",
      "pattern": "^n[1-9][0-9]*$"
    },
    "Stmt": {
      "oneOf": [
        {
          "$ref": "#/$defs/FunctionDef"
        },
        {
          "$ref": "#/$defs/ForEach"
        },
        {
          "$ref": "#/$defs/ForRange"
        },
        {
          "$ref": "#/$defs/While"
        },
        {
          "$ref": "#/$defs/If"
        },
        {
          "$ref": "#/$defs/Assign"
        },
        {
          "$ref": "#/$defs/Update"
        },
        {
          "$ref": "#/$defs/Return"
        },
        {
          "$ref": "#/$defs/Break"
        },
        {
          "$ref": "#/$defs/Continue"
        },
        {
          "$ref": "#/$defs/ExprStmt"
        },
        {
          "$ref": "#/$defs/IntentStmt"
        },
        {
          "$ref": "#/$defs/BlockHole"
        }
      ]
    },
    "FunctionDef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "FunctionDef"
        },
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "name": {
          "$ref": "#/$defs/Binding"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Binding"
          }
        },
        "body": {
          "$ref": "#/$defs/Block"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "inferred": {
          "$ref": "#/$defs/InferenceRuleId"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "notes": {
          "$ref": "#/$defs/Notes"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "params",
        "body",
        "provenance"
      ],
      "additionalProperties": false
    },
    "Binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/Name"
        },
