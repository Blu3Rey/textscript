        "kind": {
          "type": "string",
          "const": "NameHole"
        },
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "reason": {
          "$ref": "#/$defs/Text"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "inferred": {
          "$ref": "#/$defs/InferenceRuleId"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "notes": {
          "$ref": "#/$defs/Notes"
