{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EditBatch",
  "$defs": {
    "EditBatch": {
      "type": "object",
      "properties": {
        "utteranceId": {
          "$ref": "#/$defs/Text"
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EditOp"
          }
        }
      },
      "required": [
        "utteranceId",
        "ops"
      ],
      "additionalProperties": false
    },
    "Text": {
      "type": "string",
      "minLength": 1
    },
    "EditOp": {
      "oneOf": [
        {
          "$ref": "#/$defs/AddStmtOp"
        },
        {
          "$ref": "#/$defs/FillHoleOp"
        },
        {
          "$ref": "#/$defs/UpdateFieldOp"
        },
        {
          "$ref": "#/$defs/ReplaceNodeOp"
        },
        {
          "$ref": "#/$defs/RemoveNodeOp"
        },
        {
          "$ref": "#/$defs/MoveNodeOp"
        },
        {
          "$ref": "#/$defs/WrapNodesOp"
        },
        {
          "$ref": "#/$defs/RenameSymbolOp"
        },
        {
          "$ref": "#/$defs/SetLabelOp"
        },
        {
          "$ref": "#/$defs/AddNoteOp"
        },
        {
          "$ref": "#/$defs/RemoveNoteOp"
        },
        {
          "$ref": "#/$defs/AskClarificationOp"
        },
        {
          "$ref": "#/$defs/InsertAtOp"
        },
        {
          "$ref": "#/$defs/DeleteChildOp"
        },
        {
          "$ref": "#/$defs/SwapNodeOp"
        },
        {
          "$ref": "#/$defs/SetFieldOp"
        }
      ]
    },
    "AddStmtOp": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "add_stmt"
        },
        "parent": {
          "$ref": "#/$defs/NodeId"
        },
        "position": {
          "$ref": "#/$defs/InsertPosition"
        },
        "stmt": {
          "$ref": "#/$defs/Stmt"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          }
        }
      },
      "required": [
        "op",
        "parent",
        "position",
        "stmt"
      ],
      "additionalProperties": false
    },
    "NodeId": {
      "type": "string",
      "pattern": "^[nt][1-9][0-9]*$"
    },
    "InsertPosition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "enum": [
                "start",
                "end"
              ]
            }
          },
          "required": [
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "before": {
              "$ref": "#/$defs/NodeId"
            }
          },
          "required": [
            "before"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "after": {
              "$ref": "#/$defs/NodeId"
            }
          },
          "required": [
            "after"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Stmt": {
      "oneOf": [
        {
          "$ref": "#/$defs/FunctionDef"
        },
        {
          "$ref": "#/$defs/ForEach"
        },
        {
          "$ref": "#/$defs/ForRange"
        },
        {
          "$ref": "#/$defs/While"
        },
        {
          "$ref": "#/$defs/If"
        },
        {
          "$ref": "#/$defs/Assign"
        },
        {
          "$ref": "#/$defs/Update"
        },
        {
          "$ref": "#/$defs/Return"
        },
        {
          "$ref": "#/$defs/Break"
        },
        {
          "$ref": "#/$defs/Continue"
        },
        {
          "$ref": "#/$defs/ExprStmt"
        },
        {
          "$ref": "#/$defs/IntentStmt"
        },
        {
          "$ref": "#/$defs/BlockHole"
        }
      ]
    },
    "FunctionDef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "FunctionDef"
        },
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "name": {
          "$ref": "#/$defs/Binding"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Binding"
          }
        },
        "body": {
          "$ref": "#/$defs/Block"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "inferred": {
          "$ref": "#/$defs/InferenceRuleId"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "notes": {
          "$ref": "#/$defs/Notes"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "params",
        "body",
        "provenance"
      ],
      "additionalProperties": false
    },
    "Binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/Name"
        },
        {
          "$ref": "#/$defs/NameHole"
        }
      ]
    },
    "Name": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "Name"
        },
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "inferred": {
          "$ref": "#/$defs/InferenceRuleId"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "notes": {
          "$ref": "#/$defs/Notes"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "provenance"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "Provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Span"
      }
    },
    "Span": {
      "type": "object",
      "properties": {
        "utteranceId": {
          "$ref": "#/$defs/Text"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "utteranceId",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "InferenceRuleId": {
      "type": "string",
      "enum": [
        "INF-LOOPVAR",
        "INF-INDEXVAR",
        "INF-RANGE-BOUNDS",
        "INF-SYNONYM",
        "INF-PLURAL-NAME",
        "INF-BLOCK-END"
      ]
    },
    "Notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Note"
      }
    },
    "Note": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "text": {
          "$ref": "#/$defs/Text"
        },
        "tag": {
          "type": "string",
          "enum": [
            "general",
            "edge-case",
            "complexity"
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          }
        }
      },
      "required": [
        "id",
        "text",
        "tag",
        "provenance"
      ],
      "additionalProperties": false
