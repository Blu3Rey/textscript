step 5
add root:
    for r in range(len(grid)~range-bounds):
        for c in range(len(grid[r])~range-bounds):
            if grid[r][c] == 1 and (r, c) not in visited:
                islands += 1
                explore(r, c)
expect gaps GAP004 GAP001
or
add root:
    for r in range(len(grid)~range-bounds):
        for c in range(len(grid[r])~range-bounds):
            if grid[r][c] == 1 and (r, c) not in visited:
