step 1
or
note root general: products from the left side and from the right side, no division

step 2
add root: n = len(nums)
expect gaps WARN001

step 3
add root:
    prefix = [1] * n
    suffix = [1] * n
expect gaps WARN001 WARN001

step 4
add root:
    for i in range(1, n):
        prefix[i] = prefix[i - 1] * nums[i - 1]
expect gaps WARN001

step 5
add root:
    for i in range(n - 2, -1, -1):
        suffix[i] = suffix[i + 1] * nums[i + 1]
expect gaps none

step 6
add root: result = []
expect gaps WARN001

step 7
add root:
    for i in range(n):
        result.append(prefix[i] * suffix[i])
expect gaps none

step 8
add root: return result
note root complexity: linear time and linear space
expect gaps none
