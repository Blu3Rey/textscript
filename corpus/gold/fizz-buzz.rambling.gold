step 4
# The console can't add an elif to an existing if, so the if is replaced
# by the same if with the two new elif branches.
replace n13:
    if i % 15 == 0:
        answer.append("FizzBuzz")
    elif i % 3 == 0:
        answer.append("Fizz")
    elif i % 5 == 0:
        answer.append("Buzz")
expect gaps none

step 5
