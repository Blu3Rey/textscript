step 4
add root:
    queue = deque()
    for i in range(num_courses):
        if indegree[i] == 0:
            queue.append(i)
expect gaps GAP001 GAP001

step 5
add root: taken = 0
expect gaps GAP001 GAP001 WARN001

step 6
add root:
    while queue:
        course = queue.popleft()
        taken += 1
        for neighbor in graph[course]:
            indegree[neighbor] -= 1
            if indegree[neighbor] == 0:
                queue.append(neighbor)
or
add root:
    while len(queue) > 0:
        course = queue.popleft()
        taken += 1
        for neighbor in graph[course]:
            indegree[neighbor] -= 1
            if indegree[neighbor] == 0:
                queue.append(neighbor)
or
